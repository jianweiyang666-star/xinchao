# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AIHubMix OpenAI-compatible Responses API.
# If AIHUBMIX_API_KEY is set, the backend uses this provider before Gemini.
AIHUBMIX_API_KEY="MY_AIHUBMIX_API_KEY"
AIHUBMIX_BASE_URL="https://aihubmix.com/v1"
AIHUBMIX_MODEL="gpt-5.5-free"
# Use "responses" for gpt-5.5-free. Use "chat" for OpenAI-compatible chat models such as gemini-3-flash-preview-free.
AIHUBMIX_API_MODE="responses"
AIHUBMIX_REASONING_EFFORT="medium"
AIHUBMIX_VERBOSITY="low"

# Generic OpenAI-compatible provider config. Prefer this for Alibaba DashScope / Bailian.
# Fast Alibaba model for chat demo:
LLM_PROVIDER="Alibaba DashScope"
LLM_API_KEY="MY_ALIBABA_DASHSCOPE_API_KEY"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="qwen3.6-flash"
LLM_API_MODE="chat"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
